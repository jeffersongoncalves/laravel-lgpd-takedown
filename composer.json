{
    "name": "jeffersongoncalves/laravel-lgpd-takedown",
    "description": "ECA Digital notice and takedown for Laravel: public report channel with identified reporters, immediate removal of grave content (art. 27), authority reporting, author notice and appeal (art. 30), retention under Marco Civil art. 15 and abusive-reporter flags.",
    "keywords": [
        "laravel",
        "lgpd",
        "eca-digital",
        "takedown",
        "content-moderation",
        "report",
        "minors",
        "child-safety",
        "anpd"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-lgpd-takedown",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\LgpdTakedown\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\LgpdTakedown\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\LgpdTakedown\\LgpdTakedownServiceProvider"
            ],
            "aliases": {
                "LgpdTakedown": "JeffersonGoncalves\\LgpdTakedown\\Facades\\LgpdTakedown"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
